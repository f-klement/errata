# The env extractor reads one variable in every file a rule lists, each by
# the reader its name chooses, and a glob over the files git tracks. The
# README's api-port-agrees fails on the deploy job's 8081 and the smoke
# step's 9090, and names each place with its reader and its job, step or
# stage.
env GIT_CONFIG_NOSYSTEM=1
env GIT_CONFIG_GLOBAL=/dev/null
exec git init -q
exec git add .env deploy.sh .gitlab-ci.yml .github/workflows/ci.yml .github/workflows/lint.yml Jenkinsfile

! exec errata check -c port.yaml
stdout '^FALSE api-port-agrees \(repo\)$'
stdout '^          "8080" at .env:1 from envfile \(port\), deploy.sh:2 from shell \(port\), .gitlab-ci.yml:2 from gitlab-ci job "test" \(port\), .github/workflows/ci.yml:3 from github-actions job "test" \(port\), Jenkinsfile:3 from jenkins pipeline \(port\)$'
stdout '^          "8081" at .gitlab-ci.yml:6 from gitlab-ci job "deploy" \(port\)$'
stdout '^          "9090" at .github/workflows/ci.yml:10 from github-actions job "test" step "smoke" \(port\)$'
# The workflow git does not track is not read: its 7070 is nowhere.
! stdout 7070

# A value a file computes is reported as such, never compared as text: the
# Jenkinsfile's stage builds its port from another variable.
! exec errata check -c computed.yaml
stdout '^UNKNOWN port-computed \(repo\)$'
stdout '^          "\\"\$\{PORT_BASE\}1\\"" at computed/Jenkinsfile:6 from jenkins stage "deploy"$'

# A glob that matches no tracked file is no value, which allow_empty
# decides; a file whose name chooses no reader takes one from readers:.
! exec errata check -c empty.yaml
stdout 'extractor "port" found no value'
exec errata check -c allowed.yaml
stdout '^0 errata, 0 unknown. Coverage: ran 2, skipped 0.$'

# A file no reader reads is unknown, naming it.
! exec errata check -c unread.yaml
stdout 'env: no reader reads "ci/build.yml"'

# errata list prints the extractor with its max_bytes written out.
exec errata list -c allowed.yaml -f json
stdout '"env": \{\n\s+"name": "API_PORT",\n\s+"files": \[\n\s+"ci/build.yml"\n\s+\],\n\s+"readers": \{\n\s+"ci/build.yml": "gitlab-ci"\n\s+\},\n\s+"max_bytes": 33554432\n\s+\}'
-- .env --
API_PORT=8080
-- deploy.sh --
#!/bin/sh
export API_PORT=8080
./server --port "$API_PORT"
-- .gitlab-ci.yml --
variables:
  API_PORT: "8080"
test:
  script: [make test]
deploy:
  variables: {API_PORT: "8081"}
  script: [./deploy.sh]
-- .github/workflows/ci.yml --
on: push
env:
  API_PORT: "8080"
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - id: smoke
        env: {API_PORT: "9090"}
        run: ./smoke
-- .github/workflows/lint.yml --
on: push
jobs:
  lint:
    runs-on: ubuntu-latest
    steps: [{run: make lint}]
-- .github/workflows/local.yml --
on: push
env:
  API_PORT: "7070"
jobs:
  local: {runs-on: ubuntu-latest, steps: [{run: x}]}
-- Jenkinsfile --
pipeline {
    agent any
    environment { API_PORT = '8080' }
    stages {
        stage('build') { steps { sh 'make' } }
    }
}
-- computed/Jenkinsfile --
pipeline {
    agent any
    environment { API_PORT = '8080' }
    stages {
        stage('deploy') {
            environment { API_PORT = "${PORT_BASE}1" }
            steps { sh './deploy.sh' }
        }
    }
}
-- ci/build.yml --
build:
  variables: {API_PORT: "8080"}
  script: [make]
-- port.yaml --
checks:
  - id: api-port-agrees
    reason: Every place that sets API_PORT names the port the server listens on.
    scope: repo
    extract:
      port:
        env:
          name: API_PORT
          files: [.env, deploy.sh, .gitlab-ci.yml, .github/workflows/*.yml, Jenkinsfile]
    agree: [port]
-- computed.yaml --
checks:
  - id: port-computed
    reason: The Jenkinsfile names the port the server listens on.
    scope: repo
    extract:
      port: {env: {name: API_PORT, files: [computed/Jenkinsfile]}}
    agree: [port]
-- empty.yaml --
checks:
  - id: no-compose
    reason: No compose env file sets the port yet.
    scope: repo
    extract:
      port: {env: {name: API_PORT, files: [compose/*.env]}}
      dotenv: {envfile: {file: .env, name: API_PORT}}
    agree: [port, dotenv]
-- allowed.yaml --
checks:
  - id: no-compose
    reason: No compose env file sets the port yet.
    scope: repo
    extract:
      port: {env: {name: API_PORT, files: [compose/*.env]}}
      dotenv: {envfile: {file: .env, name: API_PORT}}
    agree: [port, dotenv]
    allow_empty: [port]
  - id: build-port
    reason: The build job uses the port of the env file.
    scope: repo
    extract:
      port: {env: {name: API_PORT, files: [ci/build.yml], readers: {ci/build.yml: gitlab-ci}}}
      dotenv: {envfile: {file: .env, name: API_PORT}}
    agree: [port, dotenv]
-- unread.yaml --
checks:
  - id: build-port
    reason: The build job uses the port of the env file.
    scope: repo
    extract:
      port: {env: {name: API_PORT, files: [ci/build.yml]}}
      dotenv: {envfile: {file: .env, name: API_PORT}}
    agree: [port, dotenv]
