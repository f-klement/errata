-- wrong/gatus.yaml --
apiVersion: v1
kind: ConfigMap
data:
  config.yaml: |
    external-endpoints:
      - name: landingpage-registered
        group: external
        token: x
      - name: landingpage-queue
        group: external
    endpoints:
      - name: loki-answers-queries
