-- deploy.yaml --
containers:
  - name: app
    image: registry.example/app:1.2.3
  - name: worker
    image: registry.example/worker:1.2.3
-- behind/deploy.yaml --
containers:
  - name: app
    image: registry.example/app:1.2.3
  - name: worker
    image: registry.example/worker:1.2.2
-- Chart.yaml --
name: app
appVersion: 1.2.3
