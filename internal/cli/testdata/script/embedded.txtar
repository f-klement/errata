-- broken/values.yaml --
gitlabUrl: https://gitlab.com/
runners:
  cache: {secretName: runner-cache}
  config: |
    [[runners]]
      [runners.kubernetes]
        namespace = = "gitlab-runner"
-- infra/observability/15-garage.yaml --
apiVersion: v1
kind: ConfigMap
metadata:
  name: garage-config
  namespace: observability
data:
  garage.toml: |
    [s3_api]
    s3_region = "garage"
    api_bind_addr = "[::]:3900"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: garage-bootstrap
  namespace: observability
spec:
  template:
    spec:
      containers:
        - name: bootstrap
          image: alpine/k8s:1.31.2
          env:
            - name: GARAGE_TENANTS
              value: '[{"name": "loki"}, {"name": "mimir"}, {"name": "ci-cache"}]'
