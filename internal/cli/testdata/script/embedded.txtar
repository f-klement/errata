-- swallowed/values.yaml --
gitlabUrl: https://gitlab.com/
runners:
  cache: {secretName: runner-cache}
  config: |
    [[runners]]
      [runners.kubernetes]
        namespace = "{{.Release.Namespace}}"
        image = "alpine:3.20"
        [runners.kubernetes.node_selector]
