# An assert that does not type check does not load: errata exits 2, names the
# check, shows the expression with a caret under the column, and runs nothing.
# Each file plants one break in an otherwise valid assert.
exec sh -c 'errata check -c type.yaml 2>/dev/null; echo code=$?'
stdout code=2

! exec errata check -c type.yaml
! stdout .
stderr 'check "type": assert: found no matching overload for ''_==_'' applied to ''\(list\(string\), string\)'', at line 1 column 10 of the expression:'
stderr '^    schedule == ''0 3 \* \* \*''$'
stderr '^ {13}\^$'

! exec errata check -c undeclared.yaml
stderr 'check "undeclared": assert: undeclared reference to ''threshold'', at line 1 column 40 of the expression:'
stderr '^    cron_interval\(schedule\[0\]\) <= duration\(threshold\[0\]\)$'
stderr '^ {43}\^$'

! exec errata check -c not-bool.yaml
stderr 'check "not-bool": assert: the expression has type duration; assert needs a bool, at line 1 column 14 of the expression:'

! exec errata check -c parse.yaml
stderr 'check "parse": assert: Syntax error: '

! exec errata check -c unused.yaml
stderr 'check "unused": extractor "threshold" is declared but assert does not use it'

! exec errata check -c name.yaml
stderr 'check "name": extractor "backup-schedule": assert refers to an extractor by its name, so the name must be letters, digits and _'

! exec errata check -c deep.yaml
stderr 'check "deep": assert: the expression nests deeper than 32 levels \(each term of a \+ chain, each \?: and each \.call is a level\)$'
! stderr 'line -1'

# The worked case from the ticket loads; the files it reads are absent here,
# so it is unknown before CEL runs.
! exec errata check -c good.yaml
stdout '^UNKNOWN staleness-threshold \(repo\)$'
stdout '^0 errata, 1 unknown. Coverage: ran 1, skipped 0.$'
! stderr .

-- type.yaml --
checks:
  - id: type
    reason: r
    scope: repo
    extract: {schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}}
    assert: schedule == '0 3 * * *'
-- undeclared.yaml --
checks:
  - id: undeclared
    reason: r
    scope: repo
    extract: {schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}}
    assert: cron_interval(schedule[0]) <= duration(threshold[0])
-- not-bool.yaml --
checks:
  - id: not-bool
    reason: r
    scope: repo
    extract: {schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}}
    assert: cron_interval(schedule[0])
-- parse.yaml --
checks:
  - id: parse
    reason: r
    scope: repo
    extract: {schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}}
    assert: cron_interval(schedule[0]) <=
-- unused.yaml --
checks:
  - id: unused
    reason: r
    scope: repo
    extract:
      schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}
      threshold: {regex: {file: rules.yaml, pattern: 'for: (\S+)'}}
    assert: cron_interval(schedule[0]) > duration('1h')
-- name.yaml --
checks:
  - id: name
    reason: r
    scope: repo
    extract: {backup-schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}}
    assert: 'true'
-- deep.yaml --
checks:
  - id: deep
    reason: r
    scope: repo
    extract: {schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}}
    assert: size(schedule) > 0 && size([[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]) > 0
-- good.yaml --
checks:
  - id: staleness-threshold
    reason: >
      The alert fires when no backup finished within its threshold. Below one
      interval it fires between healthy runs; above two it misses a lost run.
    scope: repo
    extract:
      schedule: {yaml: {file: cronjob.yaml, path: spec.schedule}}
      threshold: {regex: {file: rules.yaml, pattern: 'for: (\S+)'}}
    assert: >
      duration(threshold[0]) >= cron_interval(schedule[0]) &&
      duration(threshold[0]) <= cron_interval(schedule[0]) * 2
