# A rule loads and runs in the same run as a program check, with one coverage
# line. A rule that cannot compare is unknown and fails the run: an agree or
# an assert whose extractor cannot read its source. The assert is unknown
# before CEL runs, so the message is the extractor's.
! exec errata check
stdout '^UNKNOWN endpoint-agrees \(repo\)$'
stdout 'said: extractor "service": '
stdout '^        extractor "secret": '
stdout '^UNKNOWN endpoint-asserted \(repo\)$'
stdout -count=2 'said: extractor "service": '
! stdout 'assert: the expression'
stdout '^0 errata, 2 unknown. Coverage: ran 3, skipped 1.$'
stdout 'skipped live-program \(live\): no provider can read a live system'

-- errata.yaml --
checks:
  - id: endpoint-agrees
    reason: r
    scope: repo
    extract:
      service: {yaml: {file: absent.yaml, path: spec.clusterIP}}
      secret: {regex: {file: absent.txt, pattern: 'endpoint: (.*)'}}
    agree: [service, secret]
  - id: endpoint-asserted
    reason: r
    scope: repo
    extract:
      service: {yaml: {file: absent.yaml, path: spec.clusterIP}}
    assert: size(service) > 0
  - id: program
    reason: r
    scope: repo
    run: ['true']
  - id: live-program
    reason: r
    scope: live
    run: ['true']
