# A rule that does not load exits 2, names the check and the problem, and runs
# nothing. Each file plants one break in an otherwise valid rule.
exec sh -c 'errata check -c both.yaml 2>/dev/null; echo code=$?'
stdout code=2

! exec errata check -c both.yaml
stderr 'check "both": keys of two kinds of check: run makes a program check, and extract and agree make a rule; a check is one kind: remove the keys of the kinds it is not, or write a check for each'
! stdout .

! exec errata check -c neither.yaml
stderr 'check "neither": run or extract is required'

! exec errata check -c no-extractor.yaml
stderr 'check "no-extractor": extract is required for a rule'

! exec errata check -c no-relation.yaml
stderr 'check "no-relation": .*a rule needs agree or assert'

! exec errata check -c agree-and-assert.yaml
stderr 'check "agree-and-assert": .*agree and assert are both set'

! exec errata check -c undeclared.yaml
stderr 'check "undeclared": .*agree names "secret", which extract does not declare'

! exec errata check -c unused.yaml
stderr 'check "unused": .*extractor "secret" is declared but agree does not name it'

! exec errata check -c normalize.yaml
stderr 'check "normalize": .*normalize "upper" must be one of trim, lower'

! exec errata check -c timeout.yaml
stderr 'check "timeout": .*timeout applies to a program check and a generated check'

! exec errata check -c no-kind.yaml
stderr 'check "no-kind": extractor "service": an extractor sets exactly one of yaml, json, toml, regex'

! exec errata check -c extractor-typo.yaml
stderr 'check "extractor-typo": decode: .*unknown field "pth"'

! exec errata check -c rule-typo.yaml
stderr 'check "rule-typo": decode: .*unknown field "agrees"'

! exec errata check -c no-reason.yaml
stderr 'check "no-reason": reason is required'

! exec errata check -c twice.yaml
stderr 'check "twice": .*agree names "service" twice'

! exec errata check -c allow-empty-bool.yaml
stderr 'check "allow-empty-bool": decode: allow_empty takes a list of extractor names, such as allow_empty: \[name\]; true is not accepted'

! exec errata check -c allow-empty-none.yaml
stderr 'check "allow-empty-none": allow_empty lists no extractor'

! exec errata check -c allow-empty-undeclared.yaml
stderr 'check "allow-empty-undeclared": .*allow_empty names "secret", which extract does not declare'

! exec errata check -c allow-empty-program.yaml
stderr 'check "allow-empty-program": keys of two kinds of check: run makes a program check, and allow_empty makes a rule'

! exec errata check -c blank-assert.yaml
stderr 'check "blank-assert": assert is blank: write the expression or remove the key'

! exec errata check -c live-rule.yaml
stderr 'check "live-rule": .*scope "live": a rule reads files, so its scope is repo; a live extractor comes with a provider'

! exec errata check -c case-check.yaml
stderr 'check "case-check": decode: key "Agree" must be spelled "agree"'

! exec errata check -c case-extractor.yaml
stderr 'check "case-extractor": decode: extract.service: key "JSON" must be spelled "json"'

! exec errata check -c case-top.yaml
stderr 'decode: key "Checks" must be spelled "checks"'

! exec errata check -c same-spec.yaml
stderr 'check "same-spec": extractors "a" and "b" read the same place, so comparing them compares a value with itself'

! exec errata check -c allow-empty-twice.yaml
stderr 'check "allow-empty-twice": .*allow_empty names "service" twice'

! exec errata check -c normalize-none.yaml
stderr 'check "normalize-none": normalize lists no option'

# A rule with no scope gets one scope error, not a second about repo.
! exec errata check -c no-scope.yaml
stderr 'check "no-scope": scope "" must be one of repo, live, applied'
! stderr 'its scope is repo'

# Every bad check is reported in one pass.
! exec errata check -c several.yaml
stderr 'checks\[0\]: check "first": keys of two kinds of check: run makes a program check, and agree makes a rule'
stderr 'checks\[1\]: check "second": .*a rule needs agree or assert'

-- both.yaml --
checks:
  - id: both
    reason: r
    scope: repo
    run: ['true']
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
-- neither.yaml --
checks:
  - {id: neither, reason: r, scope: repo}
-- no-extractor.yaml --
checks:
  - {id: no-extractor, reason: r, scope: repo, extract: {}, assert: 'true'}
-- no-relation.yaml --
checks:
  - id: no-relation
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
-- agree-and-assert.yaml --
checks:
  - id: agree-and-assert
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    assert: service == 'x'
-- undeclared.yaml --
checks:
  - id: undeclared
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service, secret]
-- unused.yaml --
checks:
  - id: unused
    reason: r
    scope: repo
    extract:
      service: {yaml: {file: s.yaml, path: a}}
      secret: {regex: {file: m.yaml, pattern: 'endpoint: (.*)'}}
    agree: [service]
-- normalize.yaml --
checks:
  - id: normalize
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    normalize: [trim, upper]
-- timeout.yaml --
checks:
  - id: timeout
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    timeout: 5s
-- no-kind.yaml --
checks:
  - id: no-kind
    reason: r
    scope: repo
    extract: {service: {}}
    agree: [service]
-- extractor-typo.yaml --
checks:
  - id: extractor-typo
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, pth: a}}}
    agree: [service]
-- rule-typo.yaml --
checks:
  - id: rule-typo
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agrees: [service]
-- no-reason.yaml --
checks:
  - id: no-reason
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
-- several.yaml --
checks:
  - id: first
    reason: r
    scope: repo
    run: ['true']
    agree: [service]
  - id: second
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
-- twice.yaml --
checks:
  - id: twice
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service, service]
-- allow-empty-bool.yaml --
checks:
  - id: allow-empty-bool
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    allow_empty: true
-- allow-empty-none.yaml --
checks:
  - id: allow-empty-none
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    allow_empty: []
-- allow-empty-undeclared.yaml --
checks:
  - id: allow-empty-undeclared
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    allow_empty: [secret]
-- allow-empty-program.yaml --
checks:
  - {id: allow-empty-program, reason: r, scope: repo, run: ['true'], allow_empty: [service]}
-- blank-assert.yaml --
checks:
  - id: blank-assert
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    assert: ' '
-- live-rule.yaml --
checks:
  - id: live-rule
    reason: r
    scope: live
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
-- case-check.yaml --
checks:
  - id: case-check
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    Agree: [service]
-- case-extractor.yaml --
checks:
  - id: case-extractor
    reason: r
    scope: repo
    extract: {service: {json: {file: s.json, path: a}, JSON: {file: t.json, path: b}}}
    agree: [service]
-- case-top.yaml --
checks:
  - {id: a, reason: r, scope: repo, run: ['true']}
Checks:
  - {id: b, reason: r, scope: repo, run: ['false']}
-- same-spec.yaml --
checks:
  - id: same-spec
    reason: r
    scope: repo
    extract:
      a: &s {yaml: {file: deploy/service.yaml, path: spec.clusterIP}}
      b: *s
    agree: [a, b]
-- allow-empty-twice.yaml --
checks:
  - id: allow-empty-twice
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    allow_empty: [service, service]
-- normalize-none.yaml --
checks:
  - id: normalize-none
    reason: r
    scope: repo
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
    normalize: []
-- no-scope.yaml --
checks:
  - id: no-scope
    reason: r
    extract: {service: {yaml: {file: s.yaml, path: a}}}
    agree: [service]
