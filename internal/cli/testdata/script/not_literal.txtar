# A value the file only computes, such as $(git describe) in a shell script,
# is not literal. errata-computed is errata with a fake reader that marks a
# value holding $( or ${ as not literal (see cli_test.go). Plain errata reads
# every value as literal, so it compares the text and finds an erratum.
! exec errata check -c unlisted.yaml
stdout '^FALSE version-agrees \(repo\)$'
stdout '^          "\$\(git describe\)" at build.sh:2 \(shell\)$'

# A not literal value makes the rule unknown, naming the value, its file and
# its line, for agree and for assert.
! exec errata-computed check -c unlisted.yaml
stdout '^UNKNOWN version-agrees \(repo\)$'
stdout '^  said: extractor "shell" returned 1 not literal value, which a rule does not compare as text, since the file only computes such a value; list "shell" in skip_not_literal to leave such values out$'
stdout -count=2 '^          "\$\(git describe\)" at build.sh:2$'
stdout '^UNKNOWN version-asserted \(repo\)$'
stdout '^0 errata, 2 unknown. Coverage: ran 2, skipped 0.$'
! stdout 'left out'

# skip_not_literal leaves the listed extractor's not literal values out. The
# rules hold on what is left, and the text output names each value left out.
exec errata-computed check -c listed.yaml
stdout '^0 errata, 0 unknown. Coverage: ran 2, skipped 0.$'
stdout '^  left out of version-agrees \(repo\), not literal: "\$\(git describe\)" at build.sh:2 \(shell\)$'
stdout '^  left out of version-asserted \(repo\), not literal: "\$\(git describe\)" at build.sh:2 \(shell\)$'
! stdout 'UNKNOWN|FALSE'

# A false rule counts the values it left out in its message. SARIF links each
# as a related location that says it was left out, and JUnit names each in the
# case's system-out.
! exec errata-computed check -c drifted.yaml
stdout '^FALSE version-drifted \(repo\)$'
stdout '^        skip_not_literal left out 1 not literal value of extractor "shell"$'
stdout '^  left out of version-drifted \(repo\), not literal: "\$\(git describe\)" at build.sh:2 \(shell\)$'
! exec errata-computed check -c drifted.yaml --format sarif
stdout '"text": "\\"\$\(git describe\)\\" \(shell\), not literal, so skip_not_literal left it out of the comparison"'
stdout 'The values left out as not literal, as \[related locations\]: \[value 2\]\(2\)\.'
! exec errata-computed check -c drifted.yaml --format junit
stdout '<system-out>skip_not_literal left out these values, which are not literal:&#xA;  &#34;\$\(git describe\)&#34; at build.sh:2 \(shell\)</system-out>'

# A rule that holds with a value left out is a note in SARIF.
exec errata-computed check -c listed.yaml --format sarif
stdout '"text": "check version-agrees holds on the values left: skip_not_literal left out 1 not literal value of extractor \\"shell\\"\\nThe values left out as not literal are the locations of this notification\."'
# An unknown names its left out values the same way.
! exec errata-computed check -c every.yaml --format sarif
stdout '"text": "check tag-agrees is unknown: extractor \\"ci\\" found no literal value\\nskip_not_literal left out all 2 not literal values of extractor \\"ci\\", so the rule compared nothing from it\\nThe values left out as not literal are the locations of this notification\.\\nwhy: CI tags the image with the chart.s version."'
stdout -count=2 '"text": "\\"\$\{\{\{\{ [A-Za-z.]+ \}\}\}\}\\" \(ci\), not literal, so skip_not_literal left it out of the comparison"'

# An extractor whose every value was left out found no value: unknown, unless
# allow_empty lists it.
! exec errata-computed check -c every.yaml
stdout '^  said: extractor "ci" found no literal value$'
stdout '^        skip_not_literal left out all 2 not literal values of extractor "ci", so the rule compared nothing from it$'
exec errata-computed check -c every-allowed.yaml
stdout '^0 errata, 0 unknown. Coverage: ran 1, skipped 0.$'
stdout -count=2 '^  left out of tag-agrees \(repo\), not literal: "\$\{\{ [A-Za-z.]+ \}\}" at ci.yml:[0-9] \(ci\)$'

# A regex extractor returns literal values only, so plain errata refuses
# skip_not_literal over one, naming its kind: the key would do nothing.
! exec errata check -c listed.yaml
stderr 'check "version-agrees": skip_not_literal names "shell", whose kind of extractor, regex, returns only literal values, so it has nothing to leave out'
stderr 'check "version-asserted": skip_not_literal names "shell", whose kind of extractor, regex, returns only literal values'
! stdout .

# skip_not_literal that lists no extractor, one the rule does not declare, one
# twice, a bool or one bare name does not load, and neither does a program
# check with it.
! exec errata check -c skip-none.yaml
stderr 'check "skip-none": skip_not_literal lists no extractor: name the extractors whose not literal values to leave out, or remove the key'
! exec errata check -c skip-undeclared.yaml
stderr 'check "skip-undeclared": .*skip_not_literal names "make", which extract does not declare'
! exec errata-computed check -c skip-twice.yaml
stderr 'check "skip-twice": .*skip_not_literal names "shell" twice'
! exec errata check -c skip-bool.yaml
stderr 'check "skip-bool": decode: skip_not_literal takes a list of extractor names, such as skip_not_literal: \[name\]; true is not accepted'
! exec errata check -c skip-scalar.yaml
stderr 'check "skip-scalar": decode: skip_not_literal takes a list of extractor names, such as skip_not_literal: \[name\]; "shell" is not accepted'
! exec errata check -c skip-program.yaml
stderr 'check "skip-program": keys of two kinds of check: run makes a program check, and skip_not_literal makes a rule'
! stdout .

-- build.sh --
VERSION=1.4.2
VERSION=$(git describe)
-- Chart.yaml --
version: 1.4.2
-- Chart-next.yaml --
version: 1.5.0
-- ci.yml --
tag: ${{ env.TAG }}
next: ${{ inputs.tag }}
-- unlisted.yaml --
checks:
  - id: version-agrees
    reason: The build script sets the chart's version.
    scope: repo
    extract:
      chart: {yaml: {file: Chart.yaml, path: version}}
      shell: {regex: {file: build.sh, pattern: '(?m)^VERSION=(.*)$'}}
    agree: [chart, shell]
  - id: version-asserted
    reason: The build script sets the chart's version.
    scope: repo
    extract:
      chart: {yaml: {file: Chart.yaml, path: version}}
      shell: {regex: {file: build.sh, pattern: '(?m)^VERSION=(.*)$'}}
    assert: shell.all(v, v == chart[0])
-- listed.yaml --
checks:
  - id: version-agrees
    reason: The build script sets the chart's version.
    scope: repo
    extract:
      chart: {yaml: {file: Chart.yaml, path: version}}
      shell: {regex: {file: build.sh, pattern: '(?m)^VERSION=(.*)$'}}
    agree: [chart, shell]
    skip_not_literal: [shell]
  - id: version-asserted
    reason: The build script sets the chart's version.
    scope: repo
    extract:
      chart: {yaml: {file: Chart.yaml, path: version}}
      shell: {regex: {file: build.sh, pattern: '(?m)^VERSION=(.*)$'}}
    assert: size(shell) == 1 && shell[0] == chart[0]
    skip_not_literal: [shell]
-- drifted.yaml --
checks:
  - id: version-drifted
    reason: The build script sets the chart's version.
    scope: repo
    extract:
      chart: {yaml: {file: Chart-next.yaml, path: version}}
      shell: {regex: {file: build.sh, pattern: '(?m)^VERSION=(.*)$'}}
    agree: [chart, shell]
    skip_not_literal: [shell]
-- every.yaml --
checks:
  - id: tag-agrees
    reason: CI tags the image with the chart's version.
    scope: repo
    extract:
      chart: {yaml: {file: Chart.yaml, path: version}}
      ci:    {regex: {file: ci.yml, pattern: '(?m)^\w+: (.*)$'}}
    agree: [chart, ci]
    skip_not_literal: [ci]
-- every-allowed.yaml --
checks:
  - id: tag-agrees
    reason: CI tags the image with the chart's version.
    scope: repo
    extract:
      chart: {yaml: {file: Chart.yaml, path: version}}
      ci:    {regex: {file: ci.yml, pattern: '(?m)^\w+: (.*)$'}}
    agree: [chart, ci]
    skip_not_literal: [ci]
    allow_empty: [ci]
-- skip-none.yaml --
checks:
  - id: skip-none
    reason: r
    scope: repo
    extract:
      shell: {regex: {file: build.sh, pattern: 'VERSION=(.*)'}}
    agree: [shell]
    skip_not_literal: []
-- skip-undeclared.yaml --
checks:
  - id: skip-undeclared
    reason: r
    scope: repo
    extract:
      shell: {regex: {file: build.sh, pattern: 'VERSION=(.*)'}}
    agree: [shell]
    skip_not_literal: [make]
-- skip-twice.yaml --
checks:
  - id: skip-twice
    reason: r
    scope: repo
    extract:
      shell: {regex: {file: build.sh, pattern: 'VERSION=(.*)'}}
    agree: [shell]
    skip_not_literal: [shell, shell]
-- skip-bool.yaml --
checks:
  - id: skip-bool
    reason: r
    scope: repo
    extract:
      shell: {regex: {file: build.sh, pattern: 'VERSION=(.*)'}}
    agree: [shell]
    skip_not_literal: true
-- skip-scalar.yaml --
checks:
  - id: skip-scalar
    reason: r
    scope: repo
    extract:
      shell: {regex: {file: build.sh, pattern: 'VERSION=(.*)'}}
    agree: [shell]
    skip_not_literal: shell
-- skip-program.yaml --
checks:
  - {id: skip-program, reason: r, scope: repo, run: ['true'], skip_not_literal: [shell]}
