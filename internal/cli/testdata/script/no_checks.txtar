# A config with no checks does not load: it would run nothing and exit 0, so a
# gate on it would go green on nothing. Each spelling exits 2 and says why.
exec sh -c 'errata check -c empty.yaml 2>/dev/null; echo code=$?'
stdout code=2

! exec errata check -c empty.yaml
stderr 'the file holds no checks'
! stdout .

! exec errata check -c bare.yaml
stderr 'the file holds no checks'

! exec errata check -c empty-list.yaml
stderr 'the file holds no checks'

-- empty.yaml --
-- bare.yaml --
checks:
-- empty-list.yaml --
checks: []
