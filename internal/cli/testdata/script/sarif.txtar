# --format sarif writes SARIF 2.1.0 for GitHub code scanning. An erratum is a
# result; an unknown and a skipped check are notifications of the invocation,
# and the unknown sets executionSuccessful to false. The run still exits 1.
! exec errata check --format sarif
stdout '^  "version": "2.1.0",$'
stdout '"id": "drifted",$'
stdout '"text": "CI moved, so the docs must follow."'
stdout '"ruleId": "drifted",$'
stdout '"text": "says atlas, runs on builder"'
stdout '"uri": "errata.yaml",$'
stdout '"uriBaseId": "%SRCROOT%"'
stdout '"executionSuccessful": false,$'
stdout '"text": "check broken is unknown: .*errata-no-such-program'
stdout '"text": "check endpoint-agrees is unknown: extractor \\"service\\": '
stdout '"text": "check pinned skipped \(live\): no provider can read a live system"'
! stdout '"ruleId": "(holds|broken|pinned|endpoint-agrees)"'
! stderr .

# A run with no erratum and no unknown exits 0 and lists no result. A skip
# alone leaves executionSuccessful true.
exec errata check --format sarif -c clean.yaml
stdout '"results": \[\]'
stdout '"executionSuccessful": true,$'
stdout '"text": "check pinned skipped \(live\): no provider can read a live system"'

-- errata.yaml --
checks:
  - {id: holds, reason: r, scope: repo, run: ['true']}
  - {id: drifted, reason: 'CI moved, so the docs must follow.', scope: repo, run: [sh, -c, 'echo says atlas, runs on builder; exit 1']}
  - {id: broken, reason: r, scope: repo, run: [errata-no-such-program]}
  - {id: pinned, reason: r, scope: live, run: ['true']}
  - id: endpoint-agrees
    reason: r
    scope: repo
    extract:
      service: {yaml: {file: absent.yaml, path: spec.clusterIP}}
      secret: {regex: {file: absent.txt, pattern: 'endpoint: (.*)'}}
    agree: [service, secret]
-- clean.yaml --
checks:
  - {id: holds, reason: r, scope: repo, run: ['true']}
  - {id: pinned, reason: r, scope: live, run: ['true']}
