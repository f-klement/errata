# An assert rule over real files is true, false or unknown. False prints the
# expression with every value it saw and where; an error while it runs, such
# as int() of a value that is not a number, is unknown and names the value.
exec errata check -c true.yaml
stdout '^0 errata, 0 unknown. Coverage: ran 1, skipped 0.$'
! stderr .

! exec errata check -c false.yaml
cmp stdout false.txt

! exec errata check -c unknown.yaml
stdout '^UNKNOWN port-is-a-number \(repo\)$'
stdout '^  said: assert: int: "\$\{HTTPS_PORT\}": '
stdout '^          ports\[0\] = "80" at compose.yaml:4$'
stdout '^          ports\[1\] = "\$\{HTTPS_PORT\}" at compose.yaml:5$'
stdout '^0 errata, 1 unknown. Coverage: ran 1, skipped 0.$'

-- true.yaml --
checks:
  - id: staleness-threshold
    reason: The alert must wait between one backup interval and two.
    scope: repo
    extract:
      schedule:  {yaml: {file: cronjob.yaml, path: spec.schedule}}
      threshold: {regex: {file: rules.yaml, pattern: 'for: (\S+)'}}
    assert: |
      duration(threshold[0]) >= cron_interval(schedule[0]) &&
      duration(threshold[0]) <= cron_interval(schedule[0]) * 2
-- false.yaml --
checks:
  - id: staleness-threshold
    reason: The alert must wait at most one backup interval.
    scope: repo
    extract:
      schedule:  {yaml: {file: cronjob.yaml, path: spec.schedule}}
      threshold: {regex: {file: rules.yaml, pattern: 'for: (\S+)'}}
    assert: duration(threshold[0]) <= cron_interval(schedule[0])
-- false.txt --
FALSE staleness-threshold (repo)
  why:  The alert must wait at most one backup interval.
  said: assert: the expression is false
          expression: duration(threshold[0]) <= cron_interval(schedule[0])
          schedule[0] = "17 */6 * * *" at cronjob.yaml:4
          threshold[0] = "9h" at rules.yaml:3

1 erratum, 0 unknown. Coverage: ran 1, skipped 0.
-- unknown.yaml --
checks:
  - id: port-is-a-number
    reason: The proxy reads a numeric port.
    scope: repo
    extract:
      ports: {yaml: {file: compose.yaml, path: "services.web.ports[*]"}}
    assert: ports.all(p, int(p) > 0)
-- cronjob.yaml --
apiVersion: batch/v1
kind: CronJob
spec:
  schedule: "17 */6 * * *"
-- rules.yaml --
groups:
  - alert: BackupStale
    for: 9h
-- compose.yaml --
services:
  web:
    ports:
      - "80"
      - "${HTTPS_PORT}"
